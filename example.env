# Copy this file to .env and fill in values before running the app.
#
# Development uses root.settings (the default). Production sets
# DJANGO_SETTINGS_MODULE=root.settings_prod (docker-compose.selfhost.yml does
# this for you), which enforces DEBUG=False and HTTPS-only cookies.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
# DEBUG is ignored in production (settings_prod forces it False). Dev only.
DEBUG=True
# Comma-separated hostnames. In production set to your real domain(s), e.g.
# verylift.example.com — no localhost. If reaching a dev instance through a
# tunnel (e.g. Pangolin/Newt), add that tunnel hostname too, or CSRF checks
# will fail on POST requests (CSRF_TRUSTED_ORIGINS is derived from this list).
ALLOWED_HOSTS=localhost,127.0.0.1

# Path the Django admin panel is served at, instead of Django's default admin
# path (which every scanner/bot probes first). Keep the trailing slash. Can
# differ per environment.
ADMIN_URL_PATH=the-rack/

# --- Field encryption (required) ---
# Comma-separated Fernet keys for encrypted model columns (currently the
# per-user Liftosaur API key). Each key is 32 url-safe base64-encoded bytes (44
# characters). There is no default: a missing value fails at settings import.
# The FIRST key encrypts new values; the rest are retired keys still accepted
# for decryption while a rotation is in progress. Do not reuse SECRET_KEY —
# keeping them separate is what lets either be rotated on its own. Losing these
# keys makes every stored Liftosaur key permanently unrecoverable and forces
# every user to re-enter theirs. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Self-hosting without a Python toolchain? The same command via Docker alone:
#   docker run --rm ghcr.io/verylift/verylift:latest \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: prepend a new key (keeping the old one after it so existing rows
# still decrypt), redeploy, run `manage.py rotate_encrypted_fields` to
# re-encrypt every row under the new key, then drop the retired key.
FIELD_ENCRYPTION_KEYS=generate-me-see-comment-above

# --- Database ---
# Host-facing URL for native tooling (manage.py, pytest, just ci) run on the
# host against the dockerized Postgres exposed on localhost:5432. Local dev runs
# Django natively, so no override is needed.
#
# If DATABASE_URL is left unset entirely, Django falls back to a local SQLite
# file at db.sqlite3 — this is docker-compose.selfhost.yml's default for its
# `app` service (a named volume backs the file there), good for a single user
# or small friend group. Self-hosting against Postgres instead is just a
# matter of setting this to your own instance:
#   DATABASE_URL=postgres://user:password@hostname:5432/verylift
# The app container runs its own migrations, so that account needs permission
# to create and alter tables; see docs/self-hosting.md for the tradeoff.
# (Kamal instead splits owner and scoped roles — those credentials live in
# Bitwarden via .kamal/secrets-common, not here.)
DATABASE_URL=postgres://verylift:verylift@localhost:5432/verylift

# --- Gunicorn (production, optional) ---
# Worker count defaults to (2 x CPU cores) + 1. Override to pin it explicitly.
# GUNICORN_WORKERS=5
# GUNICORN_LOG_LEVEL=info

# --- Liftosaur API (optional — defaults are sensible for production) ---
# LIFTOSAUR_API_BASE=https://www.liftosaur.com
# LIFTOSAUR_API_TIMEOUT=10

# --- SSO (OIDC) ---
# Works with any spec-compliant OIDC provider (Authentik, Keycloak, Auth0,
# Okta, ...). Leave OIDC_CLIENT_ID blank to hide the SSO button on the login
# page; local username/password login still works. When set (along with the
# five endpoint URLs below), the login page shows a "Sign in with <provider>"
# button alongside local credentials.
#
# mozilla-django-oidc has no .well-known discovery support, so there is no
# base URL to derive these from -- pull all five straight from your
# provider's own discovery document, e.g. for Authentik:
#   https://auth.verylift.com/application/o/<your-app-slug>/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_OP_TOKEN_ENDPOINT and OIDC_OP_LOGOUT_ENDPOINT must share a hostname --
# the ID token's issuer is derived from whichever host serves the token
# exchange, and a mismatch can make the provider reject end-session as malformed.
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_OP_LOGOUT_ENDPOINT=
#
# Full logout (terminating the provider's SSO session, not just the local
# session) needs a provider-side invalidation flow that redirects back here --
# the redirect target must be a static URL rather than a dynamic
# post_logout_redirect_uri (see accounts.auth.build_oidc_logout_url and the
# OIDC_OP_LOGOUT_URL_METHOD comment in settings.py for why), and the exact
# admin-console/API setup depends on your provider.
#
# Label on the SSO button ("Sign in with <name>"). Defaults to "SSO" if unset.
# OIDC_PROVIDER_NAME=SSO

# --- Email (SMTP) ---
# The only mail the app sends is a password-reset link, and only when a user
# asks for one. Any relay that speaks generic SMTP works.
#
# Leaving EMAIL_HOST blank is a supported state, not a broken one: the app falls
# back to Django's console backend, so reset links are printed to the container
# log (`docker compose logs`) instead of being delivered. The flow still works
# end to end, but only someone with log access can complete it — fine for
# development, not for real users.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True is STARTTLS on port 587; EMAIL_USE_SSL=True is implicit TLS
# on port 465. Set one or the other, never both — Django refuses to start if
# both are enabled.
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Must be an address the relay accepts as a sender, or mail is silently dropped
# (or rejected) by the relay rather than by this app.
# DEFAULT_FROM_EMAIL=very lift <noreply@example.com>
# Seconds to wait on the SMTP connection before giving up. Bounded on purpose:
# sending happens on the request path, so an unbounded wait ties up a worker.
# EMAIL_TIMEOUT=10
# How long an emailed password-reset link stays valid, in seconds. Default 3600
# (one hour), deliberately shorter than Django's own three-day default.
# PASSWORD_RESET_TIMEOUT=3600

# --- Registration ---
# Close self-serve local registration (accounts:register) while keeping existing
# accounts (local or OIDC) able to log in unaffected. Default True preserves
# today's open-registration behavior.
# REGISTRATION_OPEN=True
#
# When REGISTRATION_OPEN=False, a first-time OIDC login is still allowed to
# auto-create an account if the user is a member of this group. Empty/unset
# (the default) means no exception -- OIDC signups are fully closed too. Reads
# a "groups" claim -- on a stock Authentik deployment this rides along with
# the "profile" scope this app requests by default, just make sure the
# Provider has 'profile' selected; other providers may scope/expose group
# membership differently.
# OIDC_AUTO_ENROLL_GROUP=

# Independent of the above: on every OIDC login, grants full Django admin
# access (is_staff + is_superuser) when the "groups" claim contains this
# group, and revokes both when membership is absent -- the identity provider
# becomes the source of truth for admin status among OIDC-authenticated users
# once set. Empty/unset (the default) means OIDC login never touches either
# flag. Same "groups" claim/prerequisite as OIDC_AUTO_ENROLL_GROUP above.
# OIDC_ADMIN_GROUP=

# Skips the local username/password login form entirely and sends every
# unauthenticated visitor straight into the OIDC authorization flow -- no
# local-vs-OIDC choice screen. Also force-closes self-serve local registration
# (accounts:register) regardless of REGISTRATION_OPEN above. Existing
# local-password accounts are not modified, but can no longer sign in through
# the app UI; the admin panel's own password login is unaffected and stays
# available as a break-glass path. Refuses to start (system check accounts.E001) if enabled
# without every OIDC_* var above set.
# OIDC_ONLY_LOGIN=False

# --- FitnessVolt strength standards (optional, off by default) ---
# Disabled by default as a rollout gate: FitnessVolt options never appear in
# the challenge-creation standards picker while off. Enabling for the first
# time: set FITNESSVOLT_ENABLED=True, run `manage.py refresh_fitnessvolt_cache`
# once to warm the first snapshot, and only then do populations become
# selectable.
# FITNESSVOLT_ENABLED=True
# FITNESSVOLT_API_BASE=https://fitnessvolt.com
# FITNESSVOLT_API_TIMEOUT=10
# FITNESSVOLT_SNAPSHOT_RETENTION_MONTHS=3

# --- "Close to goal" highlight (optional — defaults are sensible) ---
# Tunes when an unscored lift on the athlete's personal-performance view gets a
# "Close to goal" flag. A lift qualifies when its raw-kg gap to the first point
# is within CHALLENGES_CLOSE_TO_GOAL_GAP_FRACTION of the rep-adjusted threshold
# (0.05 = within 5%), OR the athlete is within CHALLENGES_CLOSE_TO_GOAL_REPS_GAP
# additional reps at the current weight. The highlight is capped to the closest 3
# lifts regardless of these values.
# CHALLENGES_CLOSE_TO_GOAL_GAP_FRACTION=0.05
# CHALLENGES_CLOSE_TO_GOAL_REPS_GAP=2

# --- "Final stretch" endgame point-gap suggestion (optional — sensible defaults) ---
# In the last CHALLENGES_ENDGAME_WINDOW_DAYS days before a challenge's end
# date, a single motivational suggestion restates a participant's closest
# point-gap (next point for a scored lift, first point for an unscored one). A
# lift qualifies when its raw-kg gap is within CHALLENGES_ENDGAME_GAP_FRACTION
# of the rep-adjusted threshold (0.05 = within 5%), OR — unscored lifts only —
# it is within CHALLENGES_ENDGAME_REPS_GAP additional reps at the current
# weight. Kept separate from the close-to-goal thresholds so the two features
# can be tuned independently.
# CHALLENGES_ENDGAME_WINDOW_DAYS=14
# CHALLENGES_ENDGAME_GAP_FRACTION=0.05
# CHALLENGES_ENDGAME_REPS_GAP=2

# --- Goal-setup "suggested from history" method (optional — sensible defaults) ---
# A participant's Liftosaur-history-suggested goal ladder is their best recent
# e1RM, uplifted by CHALLENGES_GOAL_SUGGESTION_UPLIFT (0.10 = +10%), expanded
# into rep-max targets. CHALLENGES_GOAL_SUGGESTION_LOOKBACK_DAYS matches the
# existing "Recent Results" window.
# CHALLENGES_GOAL_SUGGESTION_UPLIFT=0.10
# CHALLENGES_GOAL_SUGGESTION_LOOKBACK_DAYS=182

# --- Challenge invite links (optional — sensible default) ---
# How many days a challenge's shareable invite link stays live after it is
# (re)generated. The owner can regenerate at any time, which invalidates the
# previous link.
# CHALLENGES_INVITE_LINK_TTL_DAYS=7
