# Committed. Every value is fetched live from Bitwarden via the `bw` CLI — the
# vault must be unlocked first (export BW_SESSION="$(bw unlock --raw)").
KAMAL_REGISTRY_PASSWORD=$(bw get password verylift-ghcr)

SECRET_KEY=$(bw get password verylift-secret-key)
FIELD_ENCRYPTION_KEYS=$(bw get password verylift-field-encryption-keys)
OIDC_CLIENT_SECRET=$(bw get password verylift-oidc-client-secret)
EMAIL_HOST_PASSWORD=$(bw get password verylift-email-host-password)
ADMIN_URL_PATH=$(bw get password verylift-admin-url-path)

POSTGRES_PASSWORD=$(bw get password verylift-postgres-password)
POSTGRES_APP_PASSWORD=$(bw get password verylift-postgres-app-password)

# Constructed here, not stored as full URLs in the vault — only the passwords
# rotate independently; the host/user/db shape lives in this committed file.
DATABASE_URL=postgres://verylift_app:${POSTGRES_APP_PASSWORD}@verylift-db:5432/verylift
OWNER_DATABASE_URL=postgres://verylift:${POSTGRES_PASSWORD}@verylift-db:5432/verylift
