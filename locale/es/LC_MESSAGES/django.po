msgid "Could not parse JSON. Please paste a valid JSON object."
msgstr "No se pudo analizar el JSON. Pega un objeto JSON válido."

#: challenges/custom_goals.py:152
msgid "JSON payload must be an object with \"name\" and \"targets\" keys."
msgstr "El JSON debe ser un objeto con las claves \"name\" y \"targets\"."

#: challenges/custom_goals.py:160
msgid "JSON payload must include a non-empty \"name\" key."
msgstr "El JSON debe incluir una clave \"name\" no vacía."

#: challenges/custom_goals.py:165
#, python-format
msgid "Unknown unit \"%(unit)s\"; use \"kg\" or \"lb\"."
msgstr "Unidad desconocida \"%(unit)s\"; usa \"kg\" o \"lb\"."

#: challenges/custom_goals.py:173
msgid ""
"JSON payload must contain a \"targets\" object mapping lift names to rep-max "
"weights."
msgstr ""
"El JSON debe contener un objeto \"targets\" que asocie nombres de ejercicios "
"con pesos máximos por repetición."

#: challenges/custom_goals.py:190
#, python-format
msgid "Targets for \"%(lift_name)s\" must be an object of rep count to weight."
msgstr ""
"Los objetivos de \"%(lift_name)s\" deben ser un objeto que asocie número de "
"repeticiones con peso."

#: challenges/custom_goals.py:255
#, python-format
msgid ""
"\"%(lift_name)s\" %(higher_rep)sRM target can't be heavier than its "
"%(lower_rep)sRM target — lifting more reps can never require more weight "
"than fewer reps."
msgstr ""
"El objetivo de %(higher_rep)sRM de \"%(lift_name)s\" no puede ser más pesado "
"que su objetivo de %(lower_rep)sRM — levantar más repeticiones nunca puede "
"requerir más peso que menos repeticiones."

#: challenges/custom_goals.py:311
#, python-format
msgid "\"%(lift_name)s\" is missing targets for %(missing)s."
msgstr "A \"%(lift_name)s\" le faltan objetivos para %(missing)s."

