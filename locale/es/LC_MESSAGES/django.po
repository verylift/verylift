msgid "\"%(lift_name)s\" %(rep)sRM target must be a positive number."
msgstr ""
"El objetivo de %(rep)sRM de \"%(lift_name)s\" debe ser un número positivo."

#: challenges/custom_goals.py:64
#, python-format
msgid "\"%(lift_name)s\" %(rep)sRM target must be a number."
msgstr "El objetivo de %(rep)sRM de \"%(lift_name)s\" debe ser un número."

#: challenges/custom_goals.py:78
#, python-format
msgid "Unknown lift \"%(lift_name)s\" — not configured for this challenge."
msgstr ""
"Ejercicio desconocido \"%(lift_name)s\" — no configurado para este reto."

