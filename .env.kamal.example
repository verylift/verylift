# Copy to .env.kamal (gitignored) and fill in before running `just deploy` /
# `just release` / any `kamal` command. Sourced into your shell, e.g.
# `set -a; source .env.kamal; set +a`, or via direnv. Actual secrets are NOT
# here — they're fetched live from Bitwarden by .kamal/secrets; run
# `export BW_SESSION="$(bw unlock --raw)"` first.

# --- Target server (kept out of the committed deploy.yml on purpose) ---
DEPLOY_HOST=203.0.113.10          # the VPS's SSH-reachable address
DEPLOY_HOST_NAME=verylift.example.com   # public hostname behind the Cloudflare Tunnel

# --- Registry (ghcr.io/verylift/verylift) ---
GHCR_USERNAME=your-github-username

# --- Non-secret app config ---
ALLOWED_HOSTS=verylift.example.com
